{
  "name": "yangyizhi-desktop",
  "productName": "养一只",
  "version": "0.1.0",
  "private": true,
  "description": "养一只桌面客户端",
  "author": "Yangyizhi Project",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis zip --x64",
    "dist:mac": "electron-builder --mac dmg zip --arm64",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.1"
  },
  "build": {
    "appId": "app.yangyizhi.desktop",
    "productName": "养一只",
    "asar": true,
    "directories": {
      "output": "../../artifacts/desktop"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "update-core.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist",
        "to": "web",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../update-config.json",
        "to": "update-config.json"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Yangyizhi-${version}-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "category": "public.app-category.lifestyle",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Yangyizhi-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Yangyizhi-${version}-mac-${arch}.dmg"
    }
  }
}
